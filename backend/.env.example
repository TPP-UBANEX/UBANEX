# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ubanex

# API port
PORT=3000

# SendGrid (opcional — sin esto el envío de emails no funciona)
SENDGRID_API_KEY=TU_API_KEY_DE_SENDGRID
SMTP_FROM="UBANEX <noreplyubanex@gmail.com>"

# Corre el seed al iniciar el backend. En Docker lo controla docker-compose.yml
# (default true); en produccion queda desactivado al no estar definido.
UBANEX_SEED=false
